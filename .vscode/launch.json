{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run mBoM app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run hello.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hello.py",
      "console": "integratedTerminal"
    }
  ]
}
